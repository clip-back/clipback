PROJECT_NAME=Clipback API
APP_ENVIRONMENT=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/clipback
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=90
METADATA_TOTAL_TIMEOUT_SECONDS=5
METADATA_MAX_REDIRECTS=3
METADATA_MAX_RESPONSE_BYTES=1000000
METADATA_USER_AGENT=ClipbackBot/0.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
AI_TIMEOUT_SECONDS=2
AI_MAX_OUTPUT_TOKENS=64
AI_REASONING_EFFORT=none
OCR_MODEL=gpt-5.4-nano-2026-03-17
OCR_TIMEOUT_SECONDS=5
OCR_MAX_OUTPUT_TOKENS=4096
GOOGLE_CLIENT_IDS=[]
# ID-token audiences for the registered Kakao Native/REST app keys actually used by clients.
# When empty, KAKAO_REST_API_KEY remains the legacy single-audience fallback.
KAKAO_CLIENT_IDS=[]
KAKAO_REST_API_KEY=
# Optional iOS Apple login. All five values are required to enable its endpoints.
# APPLE_CLIENT_ID is the iOS bundle identifier (currently com.huturu.app).
# Private key is the server-only .p8 PEM.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Dedicated Fernet key, separate from SECRET_KEY; retain it across deployments and backups.
APPLE_TOKEN_ENCRYPTION_KEY=
SOCIAL_AUTH_TIMEOUT_SECONDS=5
STORAGE_ROOT=storage
# New originals: local (default) or private S3-compatible object storage.
# Keep STORAGE_ROOT and its volume while existing local originals remain.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
# Use the style in the Railway Bucket Credentials tab (new buckets: virtual).
S3_ADDRESSING_STYLE=virtual
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Independent deletion receipts; local development root must be outside STORAGE_ROOT.
# Initialize once with scripts/image_deletions.py init --confirm-new-namespace.
# Production S3 originals require a separate S3 ledger Bucket and credentials.
DELETION_LEDGER_BACKEND=local
DELETION_LEDGER_ROOT=deletion-ledger
DELETION_LEDGER_S3_ENDPOINT_URL=
DELETION_LEDGER_S3_BUCKET=
DELETION_LEDGER_S3_REGION=auto
DELETION_LEDGER_S3_ADDRESSING_STYLE=virtual
DELETION_LEDGER_S3_ACCESS_KEY_ID=
DELETION_LEDGER_S3_SECRET_ACCESS_KEY=
SCREENSHOT_MAX_BYTES=10485760
YOUTUBE_SUMMARY_ENABLED=true
GEMINI_API_KEY=
YOUTUBE_DATA_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
INSTAGRAM_SUMMARY_ENABLED=false
INSTAGRAM_SUMMARY_MODEL=gpt-5.4-nano-2026-03-17
