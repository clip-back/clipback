PROJECT_NAME=Clipback API
APP_ENVIRONMENT=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/clipback
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=90
METADATA_TOTAL_TIMEOUT_SECONDS=5
METADATA_MAX_REDIRECTS=3
METADATA_MAX_RESPONSE_BYTES=1000000
METADATA_USER_AGENT=ClipbackBot/0.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
AI_TIMEOUT_SECONDS=2
AI_MAX_OUTPUT_TOKENS=64
AI_REASONING_EFFORT=none
STORAGE_ROOT=storage
SCREENSHOT_MAX_BYTES=10485760
