<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상 클라우드 백업·기기 간 이전 규칙. 로그인 세션이 든 파일만 뺀다(#363). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
